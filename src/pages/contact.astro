---
import Layout from '../layouts/Layout.astro';
---

<style is:global>
  @media (max-width: 768px) {
    body {
      padding: 0 0.75rem;
    }

    .contact-info li {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }

  @media (max-width: 480px) {
    body {
      padding: 0 0.75rem;
    }
  }
</style>

<Layout title="Contact" description="Get in touch with Aksiri AI.">
  <h1 class="contact-title">Get in Touch</h1>
  <p class="contact-text">
    Ready to transform your business with Aksiri AI? Let's build something intelligent together.
  </p>

  <p class="contact-text">
    The best way to reach us is by email. Tell us a little about your business and what you'd
    like to do, and we'll get back to you.
  </p>

  <ul class="contact-info">
    <li><strong>Email:</strong> <a href="mailto:info@aksiri.ai">info@aksiri.ai</a></li>
    {/* Owner: add real contact details here when available, e.g.
        <li><strong>Phone:</strong> ...</li>
        <li><strong>Address:</strong> ...</li> */}
  </ul>
</Layout>
