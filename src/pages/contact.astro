---
import Layout from '../layouts/Layout.astro';
---

<style is:global>
  @media (max-width: 768px) {
    body {
      padding: 0 0.75rem;
    }

    .contact-info li {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .contact-form {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    body {
      padding: 0 0.75rem;
    }
  }
</style>

<Layout title="Contact" description="Get in touch with Aksiri AI.">
  <h1 class="contact-title">Get in Touch</h1>
  <p class="contact-text">
    Ready to transform your business with Aksiri AI? Let's build something intelligent together.
  </p>

  <ul class="contact-info">
    <li><strong>Phone:</strong> +44 20 7123 4567</li>
    <li><strong>Email:</strong> <a href="mailto:info@aksiri.ai">info@aksiri.ai</a></li>
    <li><strong>Address:</strong> 123 Innovation Drive, London, UK</li>
  </ul>

  <form class="contact-form" action="mailto:info@aksiri.ai" method="POST" enctype="text/plain">
    <div>
      <label for="name">Your Name</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div>
      <label for="email">Your Email</label>
      <input type="email" id="email" name="email" required />
    </div>

    <div>
      <label for="message">Your Message</label>
      <textarea id="message" name="message" rows="5" required></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Send Message</button>
  </form>
</Layout>
