---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';

// Add posts here as they are written, newest first.
const posts: { title: string; date: string; summary: string }[] = [];
---

<Layout title="Blog" description="Aksiri AI blog — notes on AI agents, development and consulting.">
  <h1 class="blog-title">Blog</h1>
  <p class="blog-text">
    Notes from the Aksiri AI team on AI agents, development and putting AI to work in business.
  </p>

  {posts.length > 0 ? (
    <div class="services-grid">
      {posts.map((post) => (
        <article class="service-card">
          <h3>{post.title}</h3>
          <time class="blog-date" datetime={post.date}>{post.date}</time>
          <p>{post.summary}</p>
        </article>
      ))}
    </div>
  ) : (
    <div class="service-card blog-empty">
      <h3>Posts coming soon</h3>
      <p>
        We haven't published anything yet. In the meantime, <a href={url('/contact')}>get in touch</a>
        if there's a topic you'd like us to cover.
      </p>
    </div>
  )}
</Layout>

<style>
  .blog-title { font-size: 2.2rem; }
  .blog-text { color: var(--text-muted); max-width: 46rem; }
  .blog-date { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem; }
  .blog-empty { margin-top: 2.5rem; max-width: 46rem; }
  .blog-empty a { color: var(--accent); }
</style>
