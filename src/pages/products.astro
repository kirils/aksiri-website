---
import { url } from '../utils/url';
import Layout from '../layouts/Layout.astro';

const features = [
  {
    title: "AI-Powered Website Builder",
    description: "Create stunning websites in minutes, not hours. Our AI understands your brand and generates a complete website tailored to your needs.",
    icon: "🎨"
  },
  {
    title: "Smart Content Generation",
    description: "Generate compelling copy for every section. From hero headlines to about pages, our AI crafts content that converts visitors into customers.",
    icon: "✍️"
  },
  {
    title: "Design Templates",
    description: "Choose from professionally designed templates or let AI create a custom design that matches your brand voice and aesthetic.",
    icon: "🖼️"
  },
  {
    title: "SEO Optimization",
    description: "Every page is automatically optimized for search engines, ensuring your new website ranks well from day one.",
    icon: "🔍"
  }
];

const steps = [
  { num: 1, title: "Describe Your Vision", text: "Tell us about your business and what you want to achieve. Our AI analyzes your inputs to understand your needs." },
  { num: 2, title: "AI Design & Build", text: "Watch as our platform generates a complete website with custom design, content, and structure." },
  { num: 3, title: "Review & Refine", text: "Interact with AI to make adjustments. Revise copy, tweak designs, or add new sections in conversation time." },
  { num: 4, title: "Publish Instantly", text: "Deploy your website to the internet with one click. Get professional hosting and domain management included." }
];

const useCases = [
  { name: "Business Websites", benefit: "Launch a professional business presence in minutes" },
  { name: "Landing Pages", benefit: "High-converting pages optimized for lead generation" },
  { name: "Portfolio Sites", benefit: "Showcase your work with an elegant, modern design" }
];

---

<Layout title="Products - Aksiri AI SaaS Platform" description="Build websites with AI using our powerful SaaS platform.">
  
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">Products</h1>
      <p class="hero-subtitle">Build stunning websites with AI in minutes, not hours</p>
    
      <div class="cta-links">
        <a href={url("/services")} class="btn btn-primary">Our Services →</a>
        <a href="#" class="btn btn-secondary">Try Free →</a>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="features-section">
    <h2 class="section-title">Everything You Need to Build Websites</h2>
    <p class="section-subtitle">Our SaaS platform provides all the tools you need to create professional websites quickly and easily.</p>

    <div class="features-grid">
      {features.map((feature, index) => (
        <article class="feature-card">
          <div class="feature-icon">{feature.icon}</div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.description}</p>
          <a href={url("/services")} class="feature-arrow">→</a>
        </article>
      ))}
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works-section bg-surface">
    <h2 class="section-title text-center">How It Works</h2>
    <p class="section-subtitle text-center">Four simple steps to your new website</p>

    <div class="steps-container">
      {steps.map((step) => (
        <div class="step-card">
          <span class="step-number">{step.num}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-text">{step.text}</p>
        </div>
      ))}
    </div>

    <a href={url("/contact")} class="btn btn-primary">Get Started Now →</a>
  </section>

  <!-- Use Cases -->
  <section class="use-cases-section">
    <h2 class="section-title">Perfect For Any Business</h2>
    <p class="section-subtitle">Whether you're a startup, small business, or enterprise, our platform scales with you</p>

    <div class="use-cases-grid">
      {useCases.map((item, index) => (
        <div class="use-case-card" data-index={index}>
          <h3 class="use-case-title">{item.name}</h3>
          <p class="use-case-benefit">{item.benefit}</p>
          <a href={url("/services")} class="feature-arrow">→</a>
        </div>
      ))}
    </div>

    <a href={url("/contact")} class="btn btn-secondary mt-4">Let Us Build Your Website →</a>
  </section>

</Layout>

<style>
  /* Base palette (--bg, --surface, --border, --text, --accent, --accent-2, --radius) */
  :root {
    --gradient-text: linear-gradient(90deg, #a855f7 0%, #ec4899 50%, #f59e0b 100%);
    --transition: all ease 0.3s;
  }

  body {
    overflow-x: hidden;
  }

  a { color: inherit; text-decoration: none; }

  /* Hero Section */
  .hero-section {
    padding: 6rem 1.5rem;
    text-align: center;
  }

  .hero-content h1.hero-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--text-muted);
    max-width: 700px;
    margin: 0 auto 2rem;
  }

  .cta-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Common Section Styles */
  section {
    padding: 6rem 1.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.125rem;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .text-center { text-align: center; }

  /* Features Section */
  .features-section {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 900px;
    margin-inline: auto;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2.5rem;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--gradient-text);
    opacity: 0;
    transition: var(--transition);
  }

  .feature-card:hover {
    transform: translateY(-5px);
    border-color: rgba(108, 92, 231, 0.3);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .feature-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .feature-desc {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .feature-arrow {
    font-size: 1.25rem;
    color: var(--accent-2);
    font-weight: bold;
    display: inline-block;
    text-decoration: none;
    transition: var(--transition);
  }

  .feature-arrow:hover {
    transform: translateX(0.25em);
    color: var(--accent);
  }

  /* How It Works Section */
  .how-it-works-section {
    position: relative;
  }

  .steps-container {
    max-width: 900px;
    margin: 0 auto 3rem;
    display: grid;
    gap: 2rem;
  }

  .step-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
    transition: var(--transition);
  }

  .step-card:hover {
    transform: translateX(5px);
    border-color: rgba(108, 92, 231, 0.3);
    box-shadow: 0 8px 30px rgba(168, 85, 247, 0.1);
  }

  .step-number {
    font-size: 3rem;
    font-weight: 700;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    display: block;
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .step-text {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .use-cases-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .use-cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto 2rem;
  }

  .use-case-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2.5rem;
    text-align: center;
    transition: var(--transition);
  }

  .use-case-card:hover {
    transform: translateY(-3px);
    border-color: rgba(108, 92, 231, 0.3);
    box-shadow: 0 15px 40px rgba(108, 92, 231, 0.2);
  }

  .use-case-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .use-case-benefit {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .cta-section {
    text-align: center;
    padding: 4rem 1.5rem;
    max-width: 900px;
    margin-inline: auto;
  }

  .btn-primary {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
    border: none;
    cursor: pointer;
  }

  .btn-secondary {
    background: var(--surface-glass);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 700;
    border: 1px solid rgba(108, 92, 231, 0.4);
    transition: var(--transition);
  }

  .btn-secondary:hover {
    background: rgba(168, 85, 247, 0.2);
    transform: translateY(-2px);
  }

  .mt-4 {
    margin-top: 2rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .use-cases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: clamp(2rem, 6vw, 3.5rem);
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .use-cases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
